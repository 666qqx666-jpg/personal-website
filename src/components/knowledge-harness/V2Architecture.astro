---
const layers=[['Task & Profile','任务意图解析 · 角色画像 · 门票元数据','查询需求结构'],['Query Planning','Query Planner · RoleRetriever','优化检索计划'],['Retrieval & Ranking','Exact · Lexical · Metadata · RRF · Reranker','候选内容列表'],['Quality Gate & Conflict Handling','去重 · 冲突分组 · Selector · Quality Gate','审查与失败处理'],['Context-Pack & RetrievalTrace','Composer · Renderer · 选择原因与门禁记录','上下文包与追踪']] as const;
---
<div class="v2-architecture" aria-label="V2 影子实验的五层架构">{layers.map(([t,m,o],i)=><div class:list={['architecture-layer',i===3&&'gate-layer',i===4&&'trace-layer']} data-architecture-layer><b>{t}</b><span>{m}</span><em>{o}</em></div>)}<div class="budget-strip"><span>Envelope <b>300</b></span><span>Current Task <b>1,400</b></span><span>Control <b>800</b></span><span>Formal + Legacy <b>2,600</b></span><span>Evidence <b>900</b></span><strong>硬上限 6,000 Token</strong></div></div>
<style>.v2-architecture{display:grid;gap:.42rem}.architecture-layer{display:grid;grid-template-columns:minmax(170px,.78fr) minmax(240px,1.35fr) minmax(120px,.7fr);gap:.75rem;align-items:center;padding:.55rem .7rem;border:1px solid rgba(79,140,255,.34);border-radius:.55rem;background:rgba(79,140,255,.055)}.architecture-layer b{font-size:.72rem}.architecture-layer span{color:var(--text-dim);font-size:.62rem}.architecture-layer em{padding:.34rem .45rem;border:1px dashed var(--c-cyan);border-radius:.45rem;color:var(--text-dim);font-size:.6rem;font-style:normal;text-align:center}.gate-layer{border-color:rgba(245,158,11,.48);background:rgba(245,158,11,.055)}.trace-layer{border-color:rgba(139,92,246,.4);background:rgba(139,92,246,.06)}.budget-strip{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.3rem}.budget-strip span,.budget-strip strong{padding:.3rem .24rem;border:1px solid var(--glass-border);border-radius:.42rem;color:var(--text-dim);font-size:.5rem;text-align:center}.budget-strip b,.budget-strip strong{color:var(--text)}@container kh-frame (max-width:560px){.architecture-layer{grid-template-columns:1fr;gap:.22rem}.budget-strip{grid-template-columns:repeat(2,1fr)}}</style>
