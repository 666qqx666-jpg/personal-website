---
import type { ValidationRun } from '../../data/knowledgeHarnessValidation'; interface Props { run: ValidationRun; } const {run}=Astro.props;
---
<article class:list={['report-excerpt',run.state]} data-validation-report={run.id}><header><span>{run.label}</span><b>{run.reportTitle}</b><small>{run.sample}</small></header><div class="score-row">{run.baselineLabel&&<span>{run.baselineLabel} <strong>{run.baselineScore}</strong></span>}<span>{run.version} <strong>{run.candidateScore}</strong></span></div><dl>{run.metrics.map((m)=><div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}</dl><p>{run.decision}</p></article>
<style>.report-excerpt{display:grid;gap:.45rem;min-width:0;padding:.7rem .75rem;border:1px solid var(--glass-border);border-radius:.35rem .35rem .75rem .35rem;background:color-mix(in srgb,var(--bg) 18%,var(--glass))}header{display:grid;gap:.12rem;padding-bottom:.36rem;border-bottom:1px solid var(--glass-border)}header span{color:var(--c-blue);font-size:.58rem;font-weight:750}header b{font-size:.68rem}header small,p{color:var(--text-dim);font-size:.54rem}.score-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(90px,1fr));gap:.35rem}.score-row span{padding:.28rem .38rem;background:rgba(79,140,255,.06);font-size:.57rem}.score-row strong{font-size:.7rem}dl{display:grid;gap:.2rem;margin:0}dl div{display:flex;justify-content:space-between;font-size:.56rem}dt{color:var(--text-dim)}dd{margin:0;font-weight:700}p{margin:0;line-height:1.4}.fail{border-top:2px solid #f59e0b}.no-cutover{border-top:2px solid var(--c-cyan)}.incomplete{border-top:2px solid var(--c-violet)}</style>
